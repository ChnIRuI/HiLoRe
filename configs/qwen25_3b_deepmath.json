{
  "model": "Qwen/Qwen2.5-3B-Instruct",
  "method": "gc",
  "seed": 2026,
  "train_prompts_per_update": 512,
  "responses_per_prompt": 8,
  "prompt_limit": 1024,
  "response_limit": 2048,
  "microbatch_token_target_per_rank": 4096,
  "remove_padding": false,
  "actor_epochs": 1,
  "updates": 60,
  "learning_rate": 0.000002,
  "optimizer": "AdamW",
  "betas": [0.9, 0.999],
  "adam_epsilon": 1e-8,
  "weight_decay": 0.0,
  "gradient_clip": 1.0,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.0,
  "lora_targets": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"],
  "grpo_clip": 0.2,
  "kl_coefficient": 0.001,
  "advantage_epsilon": 0.000001,
  "rollout_temperature": 0.6,
  "rollout_top_p": 1.0,
  "rollout_top_k": 0,
  "world_size": 4,
  "persistent_precision": "float32",
  "compute_precision": "bfloat16",
  "reduction_precision": "float32",
  "buffer_precision": "float32",
  "use_orig_params": true,
  "forward_prefetch": false,
  "backward_prefetch": "BACKWARD_PRE",
  "limit_all_gathers": true,
  "checkpoint_reentrant": false,
  "preserve_rng_state": true,
  "checkpoint_early_stop": true,
  "tf32": false,
  "strict_determinism": false,
  "calibration_microbatches": 16,
  "memory_intervals": 1024,
  "risk_intervals": 1024,
  "memory_multiplier": 1.10,
  "risk_budget": null,
  "gradient_error_threshold": 0.015,
  "minimum_compressed_tensor_bytes": 33554432,
  "maximum_compressed_tensors_per_layer": 1
}
